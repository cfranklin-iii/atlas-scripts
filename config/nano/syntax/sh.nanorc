## Syntax highlighting for Bourne shell scripts.

## Original author:  Mike Frysinger
## License:  GPL version 3 or newer

syntax sh "(\.sh|(^|/|\.)(a|ba|c|da|k|mk|pdk|tc|z)sh(rc|_profile)?|(/etc/|(^|/)\.)profile)$"
header "^#!.*/(((env|busybox)[[:blank:]]+)?(a|ba|c|da|k|mk|pdk|tc|z)?sh|openrc-run|runscript)\>"
header "-\*-.*shell-script.*-\*-"
magic "(POSIX|Bourne-Again) shell script.*text"
comment "#"

linter dash -n

# Function declarations.
color bold,green "^[[:alnum:]_-]+\(\)"

# Keywords, symbols, and comparisons.
color sand "\<(break|case|continue|do|done|elif|else|esac|exit|fi|for|function|if|in|read|return|select|shift|then|time|until|while)\>"
color sand "\<(declare|eval|exec|export|let|local)\>"
color sand "[][{}():;|`$<>!=&\]"
color sand "-(eq|ne|gt|lt|ge|le|ef|ot|nt)\>"

# Short and long options.
color sea "[[:blank:]](-[[:alpha:]]|--\<[[:alpha:]-]+)\>"

# Strings.
color latte ""([^"\]|\\.)*"|'([^'\]|\\.)*'"

# Common commands.
color sand "\<(awk|cat|cd|ch(grp|mod|own)|cp|cut|echo|env|grep|head|install|ln|make|mkdir|mv|popd|printf|pushd|rm|rmdir|sed|set|sort|tail|tar|touch|umask|unset)\>"
color normal "[.-]tar\>"

# Basic variable names (no braces).
color teal "\$([-@*#?$![:digit:]]|[[:alpha:]_][[:alnum:]_]*)"
# More complicated variable names; handles braces and replacements and arrays.
color teal "\$\{[#!]?([-@*#?$!]|[[:digit:]]+|[[:alpha:]_][[:alnum:]_]*)(\[([[:blank:]]*[[:alnum:]_]+[[:blank:]]*|@)\])?(([#%/]|:?[-=?+])[^}]*\}|\[|\})"

# Comments.
color cyan "(^|[[:blank:]])#.*"

# Trailing whitespace.
color ,green "[[:space:]]+$"
