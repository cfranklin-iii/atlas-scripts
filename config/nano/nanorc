# === Settings ===
set indicator
set historylog
set mouse
set positionlog
set locking
set nohelp
set quickblank
set tabsize 4
set tabstospaces
## === Optional/Disabled Settings === 
# set softwrap
# set linenumbers

# === Syntax ===
include ~/.config/nano/syntax/*.nanorc

# === Binds ===
bind ^Z undo main
bind ^Y redo main

# === Colors ===
set titlecolor bold,white,black
set promptcolor bold,white
set statuscolor italic,white
set errorcolor bold,red
set spotlightcolor white,grey
set selectedcolor lightwhite,#804
set stripecolor ,#444
set scrollercolor gray,#222
set numbercolor bold,gray
set keycolor bold,yellow
set functioncolor gray
