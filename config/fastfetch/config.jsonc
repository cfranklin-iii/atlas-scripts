{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	"type": "auto",
        "width": 24,
        "height": 12,
        "padding": {"top": 0, "left": 0, "right": 0, "bottom": 0}
    },
    "display": {
        "separator": " ",
        "disableLinewrap": true,
        "color": {"keys": "34"}
    },
    "modules": [
        {
            "key": "{#34}╔═══════════╗",
            "type": "custom"
        },
        {
            "key": "║ {#34} user    {#keys}║",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "║ {#32}󰇅 hname   {#keys}║",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "║ {#33}󰅐 uptime  {#keys}║",
            "type": "uptime"
        },
        {
            "key": "║ {#34}{icon} distro  {#keys}║",
            "type": "os",
            "format": "{pretty-name} | {sysname}"
        },
        {
            "key": "║ {#31} term    {#keys}║",
            "type": "terminal",
            "format": "{pretty-name} v{version}"
        },
        {
            "key": "║ {#32} shell   {#keys}║",
            "type": "shell"
        },
        {
            "key": "║ {#34}󰉉 disk    {#keys}║",
            "type": "disk"
        },
        {
            "key": "║ {#33} memory  {#keys}║",
            "type": "memory"
        },
        {
            "key": "║ {#31}󰩟 network {#keys}║",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "key": "╠═══════════╣",
            "type": "custom"
        },
        {
            "key": "║ {#39} colors  {#keys}║",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "{#34}╚═══════════╝",
            "type": "custom"
        }
    ]
}
