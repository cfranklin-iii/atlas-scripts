{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────── System ────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "│ ┌ OS",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "│ ├ KERNEL",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "│ ├ UPTIME",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "│ ├ PACKAGES",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "│ ├ SHELL",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": "│ ├ WM",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "│ ├ TERMINAL",
            "keyColor": "green"
        },
        {
            "type": "localip",
            "key": "│ └ LOCAL IP",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────── Hardware ──────────────────────────┐"
        },
        {
            "type": "host",
            "key": "│ ┌ HOST",
            "keyColor": "yellow"
        },
        {
            "type": "cpu",
            "key": "│ ├ CPU",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "│ ├ GPU",
            "keyColor": "yellow"
        },
        {
            "type": "display",
            "key": "│ ├ DISPLAY",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "│ ├ MEMORY",
            "keyColor": "yellow"
        },
        {
            "type": "swap",
            "key": "│ ├ SWAP",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "│ └ DISK",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "key": "Palette",
            "symbol": "circle"
        }
    ]
}
